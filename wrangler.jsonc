{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tuck-site",
  "account_id": "ed61a2220d42b5b8a61059cce9af9980",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tuck-site"
    }
  ],
  // TODO: tuck.sh is still on Vercel DNS. Once the tuck.sh zone is on
  // Cloudflare, add { "pattern": "tuck.sh", "custom_domain": true } here.
  "routes": [{ "pattern": "tuck.pranavkarra.me", "custom_domain": true }],
  "workers_dev": false,
  "observability": {
    "enabled": true
  }
}
